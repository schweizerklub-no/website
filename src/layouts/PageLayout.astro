---
import Layout from '~/layouts/Layout.astro';
import Header from '~/components/widgets/Header.astro';
import Footer from '~/components/widgets/Footer.astro';

import { headerData, footerData } from '~/navigation';
import type { MetaData } from '~/types';
import { defined } from '~/utils/defined';

export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;

const locale = Astro.locals.locale;
const header = headerData(locale);
const footer = footerData(locale);
---

<Layout {...defined({ metadata })} lang={locale}>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-white"
  >
    {Astro.locals.t.nav.skipToContent}
  </a>
  <slot name="header">
    <Header {...header} locale={locale} links={header.links} showToggleTheme />
  </slot>
  <main id="main">
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footer} locale={locale} />
  </slot>
</Layout>
