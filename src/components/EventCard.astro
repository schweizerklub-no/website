---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { findImage } from '~/utils/images';
import { contentHref, dateLocale } from '~/utils/locale';

export interface Props {
  event: CollectionEntry<'events'>;
  past?: boolean;
  showWeekday?: boolean;
}

const { event, past = false, showWeekday = false } = Astro.props;
const hasDetails = event.body?.trim();
const href = contentHref(event, "anlasse");
const image = event.data.image ? await findImage(event.data.image) : undefined;
const localeDate = event.data.date.toLocaleDateString(dateLocale[event.data.lang], {
  weekday: showWeekday ? 'long' : undefined,
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{hasDetails ? (
  <a
    href={href}
    class:list={['block border-2 border-primary/15 dark:border-primary/30 rounded-lg overflow-hidden transition-all bg-white dark:bg-neutral-800', past ? 'opacity-60' : 'hover:bg-primary/5 dark:hover:bg-primary/10 hover:border-primary/40 dark:hover:border-primary/50']}
  >
    {image && <Image src={image as ImageMetadata} alt={event.data.title} class="w-full h-40 object-cover" />}
    <div class="p-6">
      <time class="text-sm text-muted" datetime={event.data.date.toISOString()}>{localeDate}</time>
      <h3 class="text-xl font-semibold mt-2 mb-2">{event.data.title}</h3>
      {event.data.description && <p class="text-muted text-sm">{event.data.description}</p>}
      {event.data.location && <p class="text-xs text-muted mt-2">📍 {event.data.location}</p>}
    </div>
  </a>
) : (
  <div class:list={['border-2 border-primary/15 dark:border-primary/30 rounded-lg overflow-hidden bg-white dark:bg-neutral-800', past && 'opacity-60']}>
    {image && <Image src={image as ImageMetadata} alt={event.data.title} class="w-full h-40 object-cover" />}
    <div class="p-6">
      <time class="text-sm text-muted" datetime={event.data.date.toISOString()}>{localeDate}</time>
      <h3 class="text-xl font-semibold mt-2 mb-2">{event.data.title}</h3>
      {event.data.description && <p class="text-muted text-sm">{event.data.description}</p>}
      {event.data.location && <p class="text-xs text-muted mt-2">📍 {event.data.location}</p>}
    </div>
  </div>
)}
