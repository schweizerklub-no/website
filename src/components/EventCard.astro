---
import type { CollectionEntry } from 'astro:content';
import EventCardBody from '~/components/EventCardBody.astro';
import { contentHref } from '~/utils/locale';

export interface Props {
  event: CollectionEntry<'events'>;
  past?: boolean;
  showWeekday?: boolean;
}

const { event, past = false, showWeekday = false } = Astro.props;
const hasDetails = event.body?.trim();
const href = contentHref(event, "anlasse");
---

{hasDetails ? (
  <a
    href={href}
    class:list={['block border-2 border-primary/40 dark:border-primary/50 rounded-lg overflow-hidden transition-all bg-white dark:bg-neutral-800', past ? 'opacity-60' : 'hover:bg-primary/5 dark:hover:bg-primary/10 hover:border-primary dark:hover:border-primary']}
  >
    <EventCardBody {event} showWeekday={showWeekday} />
  </a>
) : (
  <div class:list={['border-2 border-primary/40 dark:border-primary/50 rounded-lg overflow-hidden bg-white dark:bg-neutral-800', past && 'opacity-60']}>
    <EventCardBody {event} showWeekday={showWeekday} />
  </div>
)}