---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { findImage } from '~/utils/images';

interface Props {
  member: CollectionEntry<'board'>;
  imageSize?: string;
  avatarTextSize?: string;
}

const { member, imageSize = 'w-20 h-20', avatarTextSize = 'text-3xl' } = Astro.props;
const image = member.data.image ? await findImage(member.data.image) : undefined;
---

{image ? (
  <Image src={image as ImageMetadata} alt={member.data.name} width={240} height={240} class={`${imageSize} rounded-full object-cover mx-auto mb-4`} />
) : (
  <div class={`${imageSize} rounded-full bg-primary/10 mx-auto mb-4 flex items-center justify-center`}>
    <span class={`${avatarTextSize} font-bold text-primary`}>{member.data.name.charAt(0)}</span>
  </div>
)}
<h3 class="text-lg font-semibold">{member.data.name}</h3>
<p class="text-sm text-muted">{member.data.role}</p>