---
import type { CollectionEntry } from 'astro:content';
import BoardMemberCardBody from '~/components/BoardMemberCardBody.astro';
import { contentHref } from '~/utils/locale';

export interface Props {
  member: CollectionEntry<'board'>;
  imageSize?: string;
  avatarTextSize?: string;
  showEmail?: boolean;
}

const { member, imageSize = 'w-20 h-20', avatarTextSize = 'text-3xl', showEmail = false } = Astro.props;
const hasDetails = member.body?.trim();
const href = contentHref(member, "uberUns");
---

{hasDetails ? (
  <a href={href} class="block text-center p-6 border-2 border-primary/40 dark:border-primary/50 rounded-lg transition-all bg-white dark:bg-neutral-800 hover:bg-primary/5 dark:hover:bg-primary/10 hover:border-primary dark:hover:border-primary">
    <BoardMemberCardBody {member} imageSize={imageSize} avatarTextSize={avatarTextSize} />
    {showEmail && member.data.email && <span class="text-xs text-primary dark:text-red-400 mt-2 block">{member.data.email}</span>}
  </a>
) : (
  <div class="text-center p-6 border-2 border-primary/40 dark:border-primary/50 rounded-lg bg-white dark:bg-neutral-800">
    <BoardMemberCardBody {member} imageSize={imageSize} avatarTextSize={avatarTextSize} />
    {showEmail && member.data.email && (
      <a href={`mailto:${member.data.email}`} class="text-xs text-primary dark:text-red-400 hover:underline mt-2 block">{member.data.email}</a>
    )}
  </div>
)}