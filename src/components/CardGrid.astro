---
export interface Props {
  title: string;
  wide?: boolean;
  bgPage?: boolean;
}

const { title, wide = false, bgPage = false } = Astro.props;
---

<section class:list={['py-20 px-4', bgPage ? 'bg-primary/[6%] dark:bg-neutral-900' : 'bg-primary/[3%] dark:bg-neutral-800/50']}>
  <div class:list={['mx-auto', wide ? 'max-w-7xl' : 'max-w-5xl']}>
    <h2 class="text-3xl font-bold mb-10 text-center">{title}</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <slot />
    </div>
  </div>
</section>
