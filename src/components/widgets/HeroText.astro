---
import type { CallToAction } from '~/types';
import Button from '~/components/ui/Button.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  content?: string;
  callToAction?: string | CallToAction;
  callToAction2?: string | CallToAction;
  backgroundImage?: string;
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction = await Astro.slots.render('callToAction'),
  callToAction2 = await Astro.slots.render('callToAction2'),
  backgroundImage,
} = Astro.props;

const hasBg = !!backgroundImage;
---

<section
  class:list={['relative md:-mt-[76px] not-prose bg-cover bg-center', hasBg && 'text-white']}
  style={hasBg ? { backgroundImage: `url(${backgroundImage})` } : undefined}
>
  {hasBg && <div class="absolute inset-0 bg-black/50" aria-hidden="true" />}
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="min-h-[70vh] flex flex-col justify-start pt-24 md:pt-32">
      <div class="text-center max-w-5xl mx-auto">
        {
          tagline && (
            <p
              class:list={['text-xl md:text-3xl font-bold tracking-wide mb-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade', hasBg ? 'text-white' : 'text-primary']}
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class:list={['text-4xl md:text-6xl font-bold leading-tighter mb-16 font-heading intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade', hasBg ? 'text-white' : 'dark:text-gray-200']}
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class:list={['text-xl mb-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade', hasBg ? 'text-gray-200' : 'text-muted dark:text-slate-300']}
                set:html={subtitle}
              />
            )
          }
          <div
            class="max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
          >
            {
              callToAction && (
                <div class="flex w-full sm:w-auto">
                  {typeof callToAction === 'string' ? (
                    <Fragment set:html={callToAction} />
                  ) : (
                    <Button variant="primary" {...callToAction} />
                  )}
                </div>
              )
            }
            {
              callToAction2 && (
                <div class="flex w-full sm:w-auto">
                  {typeof callToAction2 === 'string' ? (
                    <Fragment set:html={callToAction2} />
                  ) : (
                    <Button variant={hasBg ? 'primary' : 'secondary'} {...callToAction2} />
                  )}
                </div>
              )
            }
          </div>
        </div>
        {content && <Fragment set:html={content} />}
      </div>
    </div>
  </div>
</section>
