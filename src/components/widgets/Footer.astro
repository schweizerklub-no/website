---
import { Icon } from 'astro-icon/components';
import { SITE } from '~/config';
import { getHomePermalink } from '~/utils/permalinks';
import { UI } from '~/i18n';
import type { Locale } from '~/config';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
  locale: Locale;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', theme = 'light', locale } = Astro.props;
const t = UI[locale].footer;
const homeHref = locale === 'no' ? '/no/' : getHomePermalink();
---

<footer class:list={[{ dark: theme === 'dark' }, 'not-prose border-t border-primary/15 dark:border-primary/30']}>

  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-12 gap-6 py-8 md:py-10">
      <div class="col-span-12 lg:col-span-4">
        <a class="inline-block font-bold text-lg text-primary" href={homeHref}>
          {SITE?.name}
        </a>
        <p class="text-sm text-muted mt-1 max-w-xs">
          {t.tagline}
        </p>
        <div class="flex gap-3 mt-4">
          {socialLinks.map(({ ariaLabel, href, icon }) => (
            <a
              class="text-muted hover:text-primary dark:hover:text-primary transition-colors duration-150"
              aria-label={ariaLabel}
              href={href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {icon && <Icon name={icon} class="w-5 h-5" />}
            </a>
          ))}
        </div>
      </div>

      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-4">
            <h3 class="text-xs font-semibold text-primary uppercase tracking-widest mb-3">{title}</h3>
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="text-sm space-y-2">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="text-muted hover:text-primary dark:hover:text-primary transition-colors duration-150"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      {text}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between py-4 border-t border-primary/15 dark:border-primary/30 gap-2">
      <div class="text-xs text-muted">
        {secondaryLinks.map(({ text, href }, i) => (
          <>
            {i > 0 && <span class="mx-2">·</span>}
            <a class="hover:text-primary dark:hover:text-primary transition-colors duration-150" href={href}>{text}</a>
          </>
        ))}
      </div>
      <div class="text-xs text-muted" set:html={footNote} />
    </div>
  </div>
</footer>
