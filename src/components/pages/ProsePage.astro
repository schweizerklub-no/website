---
import PageLayout from '~/layouts/PageLayout.astro';
import PageSection from '~/components/PageSection.astro';
import { getPage } from '~/utils/locale';
import { pageSlug, type PageKey } from '~/utils/pages';

export interface Props {
  page: PageKey;
  showEmail?: boolean;
}

const { page, showEmail } = Astro.props;
const { entry, Content } = await getPage(Astro.locals.locale, pageSlug(Astro.locals.locale, page));
const metadata = { title: entry.data.title };
const { misc: m } = Astro.locals.t;
---

<PageLayout {metadata}>
  <PageSection title={entry.data.title} prose>
    <Content />
    {showEmail && (
      <p><a href={`mailto:${m.email}`}>{m.email}</a></p>
    )}
  </PageSection>
</PageLayout>
