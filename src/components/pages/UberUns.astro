---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import BoardMemberCard from '~/components/BoardMemberCard.astro';
import PageSection from '~/components/PageSection.astro';
import CardGrid from '~/components/CardGrid.astro';
import { getPage } from '~/utils/locale';
import { sortBoardMembers } from '~/utils/board';

const t = Astro.locals.t.pages;
const { entry, Content } = await getPage(Astro.locals.locale, "uber-uns");
const boardMembers = sortBoardMembers(
  await getCollection("board", ({ data }) => data.lang === Astro.locals.locale),
);

const metadata = { title: entry.data.title };
---

<PageLayout metadata={metadata}>
  <HeroText
    title={t.aboutTitle}
    tagline={t.aboutTagline}
    backgroundImage="/images/about-hero.jpg"
  />

  <PageSection prose>
    <Content />
  </PageSection>

  {boardMembers.length > 0 && (
    <CardGrid title={t.vorstand}>
      {boardMembers.map((member) => (
        <BoardMemberCard member={member} showEmail />
      ))}
    </CardGrid>
  )}
</PageLayout>
