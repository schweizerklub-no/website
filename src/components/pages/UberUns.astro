---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import BoardMemberCard from '~/components/BoardMemberCard.astro';
import PageSection from '~/components/PageSection.astro';
import CardGrid from '~/components/CardGrid.astro';
import Button from '~/components/ui/Button.astro';
import { getPage } from '~/utils/locale';
import { pageSlug } from '~/utils/pages';
import { sortBoardMembers } from '~/utils/board';

const t = Astro.locals.t.pages;
const { entry, Content } = await getPage(Astro.locals.locale, pageSlug(Astro.locals.locale, "uberUns"));
const boardMembers = sortBoardMembers(
  await getCollection("board", ({ data }) => data.lang === Astro.locals.locale),
);

const metadata = { title: entry.data.title };
---

<PageLayout metadata={metadata}>
  <HeroText
    title={t.aboutTitle}
    tagline={t.aboutTagline}
    backgroundImage="/images/about-hero.jpg"
  />

  <PageSection prose>
    <Content />
    <div class="not-prose mt-8 flex flex-col gap-4 sm:flex-row">
      <Button
        variant="primary"
        target="_blank"
        href="/documents/statuten.pdf"
        text={t.statuten}
        icon="tabler:file-type-pdf"
      />
      <Button
        variant="primary"
        target="_blank"
        href="/documents/bilanz-gewinn-verlustrechnung_2025.pdf"
        text={t.bilanz}
        icon="tabler:file-type-pdf"
      />
    </div>
  </PageSection>

  {boardMembers.length > 0 && (
    <CardGrid title={t.vorstand}>
      {boardMembers.map((member) => (
        <BoardMemberCard member={member} showEmail />
      ))}
    </CardGrid>
  )}
</PageLayout>
