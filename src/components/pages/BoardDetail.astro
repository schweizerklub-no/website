---
import PageLayout from '~/layouts/PageLayout.astro';
import BackLink from '~/components/BackLink.astro';
import type { Locale } from '~/config';
import { localeUrlPrefix } from '~/utils/locale';

export interface Props {
  entry: {
    data: {
      name: string;
      role: string;
      image?: string;
      email?: string;
      bio?: string;
      lang: Locale;
    };
  };
  Content: any;
}

const { entry, Content } = Astro.props;
const metadata = { title: entry.data.name };
const t = Astro.locals.t.pages;
---

<PageLayout metadata={metadata}>
  <article class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <BackLink href={`${localeUrlPrefix[entry.data.lang]}/uber-uns/`} label={t.backToBoard} />

      <div class="flex flex-col md:flex-row gap-8 items-start">
        {entry.data.image ? (
          <img src={entry.data.image} alt={entry.data.name} class="w-48 h-48 rounded-full object-cover shrink-0" />
        ) : (
          <div class="w-48 h-48 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
            <span class="text-6xl font-bold text-primary">{entry.data.name.charAt(0)}</span>
          </div>
        )}

        <div>
          <h1 class="text-4xl font-bold mb-2">{entry.data.name}</h1>
          <p class="text-xl text-muted mb-4">{entry.data.role}</p>
          {entry.data.email && (
            <a href={`mailto:${entry.data.email}`} class="text-primary hover:underline text-sm">
              {entry.data.email}
            </a>
          )}
        </div>
      </div>

      {entry.data.bio && <p class="text-muted mt-8 mb-6">{entry.data.bio}</p>}

      <div class="prose dark:prose-invert max-w-none prose-a:text-primary dark:prose-a:text-primary">
        <Content />
      </div>
    </div>
  </article>
</PageLayout>
