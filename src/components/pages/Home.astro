---
import { getCollection } from "astro:content";
import HeroText from "~/components/widgets/HeroText.astro";
import EventCard from "~/components/EventCard.astro";
import BoardMemberCard from "~/components/BoardMemberCard.astro";
import CardGrid from "~/components/CardGrid.astro";
import PageLayout from "~/layouts/PageLayout.astro";
import Button from "~/components/ui/Button.astro";
import { EventConfig } from "~/site-config";
import { getUpcomingEvents } from "~/utils/events";
import { localeUrlPrefix } from "~/utils/locale";
import { sortBoardMembers } from "~/utils/board";

const t = Astro.locals.t;
const locale = Astro.locals.locale;
const upcomingEvents = await getUpcomingEvents(locale, EventConfig.HOMEPAGE_EVENTS_MAX + 1);
const boardMembers = sortBoardMembers(
  await getCollection("board", ({ data }) => data.lang === locale),
);

const metadata = {
  title: t.home.metaTitle,
};
---

<PageLayout metadata={metadata}>
  <HeroText
    title={t.home.title}
    tagline={t.home.tagline}
    backgroundImage="/images/hero-bg.jpg"
    callToAction={{
      text: t.home.cta1,
      href: `${localeUrlPrefix[locale]}/mitgliedschaft/`,
    }}
    callToAction2={{
      text: t.home.cta2,
      href: `${localeUrlPrefix[locale]}/uber-uns/`,
    }}
  />

  {
    upcomingEvents.length > 0 && (
      <CardGrid title={t.home.events} wide>
        {upcomingEvents.slice(0, EventConfig.HOMEPAGE_EVENTS_MAX).map((event) => (
          <EventCard event={event} />
        ))}
        {upcomingEvents.length > EventConfig.HOMEPAGE_EVENTS_MAX && (
          <div class="col-span-full flex justify-center mt-8">
            <Button
              variant="secondary"
              text={t.pages.backToEvents}
              href={`${localeUrlPrefix[locale]}/anlasse/`}
            />
          </div>
        )}
      </CardGrid>
    )
  }

  {
    boardMembers.length > 0 && (
      <CardGrid title={t.home.board} wide bgPage>
        {boardMembers.map((member) => (
          <BoardMemberCard
            member={member}
            imageSize="w-24 h-24"
            avatarTextSize="text-2xl"
          />
        ))}
      </CardGrid>
    )
  }
</PageLayout>
