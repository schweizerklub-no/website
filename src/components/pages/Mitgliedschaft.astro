---
import PageLayout from "~/layouts/PageLayout.astro";
import PageSection from "~/components/PageSection.astro";
import { getPage } from "~/utils/locale";
import { pageSlug } from "~/utils/pages";
import { BANK_ACCOUNT } from "~/config";

const { pages: t } = Astro.locals.t;
const { entry, Content } = await getPage(
  Astro.locals.locale,
  pageSlug(Astro.locals.locale, "mitgliedschaft"),
);
const metadata = { title: entry.data.title };
---

<PageLayout metadata={metadata}>
  <PageSection title={entry.data.title}>
    <div
      class="prose dark:prose-invert max-w-none prose-a:text-primary dark:prose-a:text-primary mb-12"
    >
      <Content />
    </div>

    <h3 class="text-lg font-semibold mb-3">{t.bankTransfer}</h3>
    <div
      class="bg-white dark:bg-neutral-800 border-2 border-primary/15 dark:border-primary/30 rounded-lg p-5 mb-8"
    >
      <div class="space-y-1.5">
        <p class="text-sm">
          <span class="font-semibold">{t.accountName}</span>
          {BANK_ACCOUNT.name}
        </p>
        <p class="text-sm">
          <span class="font-semibold">{t.accountNumber}</span>
          {BANK_ACCOUNT.number}
        </p>
        <p class="text-sm">
          <span class="font-semibold">{t.accountMessage}</span>
          {t.membershipMessage}
        </p>
      </div>
    </div>

    <h3 class="text-lg font-semibold mb-3">{t.vippsPayment}</h3>
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      <div
        class="bg-white dark:bg-neutral-800 border-2 border-primary/15 dark:border-primary/30 rounded-lg p-6 text-center"
      >
        <h3 class="text-lg font-semibold mb-2">{t.singleMember}</h3>
        <p class="text-3xl font-bold text-primary mb-4">200 NOK</p>
        <img
          src="/images/membership/qr-code-102059-membership-single.png"
          alt="Vipps 200 NOK"
          class="w-40 h-40 mx-auto"
        />
      </div>
      <div
        class="bg-white dark:bg-neutral-800 border-2 border-primary/15 dark:border-primary/30 rounded-lg p-6 text-center"
      >
        <h3 class="text-lg font-semibold mb-2">{t.familyMember}</h3>
        <p class="text-3xl font-bold text-primary mb-4">400 NOK</p>
        <img
          src="/images/membership/qr-code-102059-membership-family.png"
          alt="Vipps 400 NOK"
          class="w-40 h-40 mx-auto"
        />
      </div>
    </div>
    <h3 class="text-lg font-semibold mb-3">{t.membershipForm}</h3>
    <div
      class="bg-white dark:bg-neutral-800 border-2 border-primary/15 dark:border-primary/30 rounded-lg p-6 text-center"
    >
      <a href="https://eepurl.com/dkU3Ub" class="btn" data-membership-loading>
        <span data-membership-loading-label>{t.membershipFormButton}</span>
        <span class="hidden" data-membership-loading-spinner aria-hidden="true">
          <span
            class="inline-block h-4 w-4 border-2 border-current border-t-transparent rounded-full animate-spin mr-2 align-middle"
          ></span>
        </span>
        <span class="hidden" data-membership-loading-text
          >{t.membershipFormLoading}</span
        >
      </a>
    </div>
  </PageSection>
</PageLayout>

<script>
  const isModifierClick = (event: MouseEvent) =>
    event.button !== 0 ||
    event.metaKey ||
    event.ctrlKey ||
    event.shiftKey ||
    event.altKey;

  const showLoading = (link: HTMLAnchorElement) => {
    link.classList.add("cursor-wait");
    link.setAttribute("aria-busy", "true");
    link.setAttribute("aria-disabled", "true");
    link
      .querySelector("[data-membership-loading-label]")
      ?.classList.add("hidden");
    link
      .querySelector("[data-membership-loading-spinner]")
      ?.classList.remove("hidden");
    link
      .querySelector("[data-membership-loading-text]")
      ?.classList.remove("hidden");
  };

  const recover = (link: HTMLAnchorElement) => {
    delete link.dataset.navigating;
    link.classList.remove("cursor-wait");
    link.removeAttribute("aria-busy");
    link.removeAttribute("aria-disabled");
    link
      .querySelector("[data-membership-loading-label]")
      ?.classList.remove("hidden");
    link
      .querySelector("[data-membership-loading-spinner]")
      ?.classList.add("hidden");
    link
      .querySelector("[data-membership-loading-text]")
      ?.classList.add("hidden");
  };

  const onClick = (event: MouseEvent) => {
    if (isModifierClick(event)) return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>("[data-membership-loading]");
    if (!link || link.dataset.navigating) return;
    event.preventDefault();
    link.dataset.navigating = "true";
    showLoading(link);
    window.setTimeout(() => {
      window.location.href = link.href;
    }, 150);
    window.setTimeout(() => recover(link), 8000);
  };

  const init = () => {
    if (document.documentElement.dataset.membershipLoadingInit) return;
    document.documentElement.dataset.membershipLoadingInit = "true";
    document.addEventListener("click", onClick);
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
