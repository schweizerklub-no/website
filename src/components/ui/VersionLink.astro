---
const version = import.meta.env.PUBLIC_APP_VERSION || '0.0.0-dev';
const repoUrl = 'https://github.com/schweizerklub-no/website';
---

{
  version !== '0.0.0-dev' ? (
    <a
      class="text-muted/60 hover:text-primary dark:hover:text-primary transition-colors duration-150"
      href={`${repoUrl}/releases/tag/${version}`}
    >
      {version}
    </a>
  ) : (
    <span class="text-muted/60">{version}</span>
  )
}
