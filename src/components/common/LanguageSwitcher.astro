---
import { UI } from "~/i18n";
import { localeUrlPrefix } from "~/utils/locale";
import type { Locale } from "~/config";
import LanguageLink from "~/components/common/LanguageLink.astro";

export interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const basePath = pathname.replace(localeUrlPrefix[locale], "") || "/";

const links = (Object.keys(localeUrlPrefix) as Locale[])
  .filter((l) => l !== locale)
  .map((l) => {
    const href = `${localeUrlPrefix[l]}${basePath}`.replace(/\/?$/, "/");
    return { href, label: UI[l].label, lang: l };
  });
---

<div class="relative" data-lang-wrapper>
  <button type="button" data-lang-toggle class="flex items-center gap-1 text-sm font-semibold uppercase tracking-widest text-muted bg-page px-3 py-3 rounded cursor-pointer select-none">
    {locale}
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>
  <div class="absolute z-50 bg-page rounded shadow-lg hidden max-md:left-0 max-md:bottom-full max-md:mb-1 md:right-0 md:top-full" data-lang-dropdown>
    {links.map((link) => <LanguageLink {...link} />)}
  </div>
</div>
