---
import { UI } from "~/i18n";
import { localeUrlPrefix } from "~/utils/locale";
import type { Locale } from "~/config";
import { translatePath } from "~/utils/language-path";
import LanguageLink from "~/components/common/LanguageLink.astro";

export interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const links = (Object.keys(localeUrlPrefix) as Locale[])
  .filter((l) => l !== locale)
  .map((l) => {
    const href = translatePath(pathname, locale, l);
    return { href, label: UI[l].label, lang: l };
  });
---

<div class="relative" data-lang-wrapper>
  <button
    type="button"
    data-lang-toggle
    aria-haspopup="true"
    aria-expanded="false"
    class="flex items-center gap-1 text-sm font-semibold uppercase tracking-widest text-muted bg-page px-3 py-3 rounded cursor-pointer select-none"
  >
    {locale}
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>
  <div
    class="absolute z-50 bg-page rounded shadow-lg hidden max-md:left-0 max-md:bottom-full max-md:mb-1 md:right-0 md:top-full"
    data-lang-dropdown
  >
    {links.map((link) => <LanguageLink {...link} />)}
  </div>
</div>

<script>
  if (!document.documentElement.dataset.langSwitcherInit) {
    document.documentElement.dataset.langSwitcherInit = 'true';

    const closeWrapper = (wrapper: HTMLElement) => {
      const dropdown = wrapper.querySelector<HTMLElement>('[data-lang-dropdown]');
      const toggle = wrapper.querySelector<HTMLElement>('[data-lang-toggle]');
      if (!dropdown || dropdown.classList.contains('hidden')) return;
      dropdown.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    };

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      document.querySelectorAll<HTMLElement>('[data-lang-wrapper]').forEach((wrapper) => {
        if (!wrapper.contains(target)) closeWrapper(wrapper);
      });
    });

    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLElement>('[data-lang-wrapper]').forEach((wrapper) => {
        const toggle = wrapper.querySelector<HTMLElement>('[data-lang-toggle]');
        const dropdown = wrapper.querySelector<HTMLElement>('[data-lang-dropdown]');
        if (!toggle || !dropdown) return;
        const links = Array.from(dropdown.querySelectorAll<HTMLAnchorElement>('a'));
        if (links.length === 0) return;

        const setExpanded = (expanded: boolean) => toggle.setAttribute('aria-expanded', String(expanded));

        const open = () => {
          dropdown.classList.remove('hidden');
          setExpanded(true);
        };

        const close = ({ returnFocus = false }: { returnFocus?: boolean } = {}) => {
          dropdown.classList.add('hidden');
          setExpanded(false);
          if (returnFocus) toggle.focus();
        };

        const focusLink = (index: number) => {
          (links[index] ?? links[0])?.focus();
        };

        const currentIndex = () =>
          dropdown.contains(document.activeElement) ? links.indexOf(document.activeElement as HTMLAnchorElement) : -1;

        const focusNext = (direction: 1 | -1) => {
          const current = currentIndex();
          focusLink(current === -1 ? (direction === 1 ? 0 : links.length - 1) : (current + direction + links.length) % links.length);
        };

        toggle.addEventListener('click', () => {
          if (dropdown.classList.contains('hidden')) open();
          else close();
        });

        toggle.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            if (dropdown.classList.contains('hidden')) open();
            focusNext(event.key === 'ArrowDown' ? 1 : -1);
          } else if (event.key === 'Escape') {
            event.preventDefault();
            close({ returnFocus: true });
          }
        });

        links.forEach((link) => {
          link.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowDown') {
              event.preventDefault();
              focusNext(1);
            } else if (event.key === 'ArrowUp') {
              event.preventDefault();
              focusNext(-1);
            } else if (event.key === 'Home') {
              event.preventDefault();
              focusLink(0);
            } else if (event.key === 'End') {
              event.preventDefault();
              focusLink(links.length - 1);
            } else if (event.key === 'Escape') {
              event.preventDefault();
              close({ returnFocus: true });
            }
          });
        });
      });
    });
  }
</script>
