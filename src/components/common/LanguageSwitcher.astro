---
import { UI } from "~/i18n";
import { localeUrlPrefix } from "~/utils/locale";
import type { Locale } from "~/config";
import LanguageLink from "~/components/common/LanguageLink.astro";

export interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const basePath = pathname.replace(localeUrlPrefix[locale], "") || "/";

const links = (Object.keys(localeUrlPrefix) as Locale[])
  .filter((l) => l !== locale)
  .map((l) => {
    const href = `${localeUrlPrefix[l]}${basePath}`.replace(/\/?$/, "/");
    return { href, label: UI[l].label, lang: l };
  });
---

<div class="relative group">
  <span class="flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-muted px-2 py-1 rounded cursor-default select-none">
    {locale}
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </span>
  <div class="absolute right-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity duration-150 z-50">
    {links.map((link) => <LanguageLink {...link} />)}
  </div>
</div>
