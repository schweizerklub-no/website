---
import { UI } from "~/i18n";
import type { Locale } from "~/config";

export interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;

const otherLocale: Locale = locale === "de" ? "no" : "de";

const basePath = locale === "no" ? pathname.replace(/^\/no(?:\/|$)/, "/") : pathname;
const otherPath = (otherLocale === "no" ? `/no${basePath}` : basePath).replace(/\/?$/, "/");
---

<div class="relative group">
  <span class="flex items-center gap-1 text-xs font-semibold uppercase tracking-widest text-muted px-2 py-1 rounded cursor-default select-none">
    {locale}
    <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M6 9l6 6 6-6" />
    </svg>
  </span>
  <div class="absolute right-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-opacity duration-150 z-50">
    <a
      href={otherPath}
      class="block text-xs font-semibold uppercase tracking-widest text-muted hover:text-primary dark:hover:text-primary bg-page border border-primary/15 dark:border-primary/30 rounded px-2 py-1.5 whitespace-nowrap transition-colors duration-150 hover:bg-primary/5"
      aria-label={otherLocale === "de" ? "Auf Deutsch" : "Switch to Norwegian"}
      rel="alternate"
      hreflang={otherLocale}
    >
      {UI[otherLocale].label}
    </a>
  </div>
</div>
