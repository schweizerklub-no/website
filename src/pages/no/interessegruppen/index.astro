---
import PageLayout from '~/layouts/PageLayout.astro';
import PageSection from '~/components/PageSection.astro';
import { UI } from '~/i18n';

const t = UI.no.pages;
const metadata = { title: t.interessegruppen };
---

<PageLayout metadata={metadata}>
  <PageSection title={t.interessegruppen}>
    <p class="text-muted mb-6">{t.groupsIntro1}</p>
    <p class="text-muted mb-6">{t.groupsIntro2}</p>
    <p class="text-muted">{t.groupsIntro3}</p>
  </PageSection>
</PageLayout>
