---
import PageLayout from '~/layouts/PageLayout.astro';
import PageSection from '~/components/PageSection.astro';

const { pages: t, misc: m } = Astro.locals.t;
const metadata = { title: t.beitritt };
---

<PageLayout metadata={metadata}>
  <PageSection title={t.beitritt}>
    <p class="text-muted mb-6">{t.beitrittIntro}</p>

    <h2 class="text-2xl font-semibold mb-4">{t.memberFee}</h2>
    <div class="grid md:grid-cols-2 gap-6 mb-8">
      <div class="border border-default rounded-lg p-6 text-center">
        <h3 class="text-lg font-semibold mb-2">{t.singleMember}</h3>
        <p class="text-3xl font-bold text-primary mb-2">200 NOK</p>
        <p class="text-sm text-muted">{t.perYear}</p>
      </div>
      <div class="border border-default rounded-lg p-6 text-center">
        <h3 class="text-lg font-semibold mb-2">{t.familyMember}</h3>
        <p class="text-3xl font-bold text-primary mb-2">400 NOK</p>
        <p class="text-sm text-muted">{t.perYear}</p>
      </div>
    </div>

    <h2 class="text-2xl font-semibold mb-4">{t.signup}</h2>
    <p class="text-muted mb-4">
      {t.signupText}
    </p>
    <a href={`mailto:${m.email}`} class="text-primary hover:underline font-medium">
      {m.email}
    </a>
  </PageSection>
</PageLayout>
