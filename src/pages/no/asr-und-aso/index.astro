---
import PageLayout from '~/layouts/PageLayout.astro';
import PageSection from '~/components/PageSection.astro';
import { UI } from '~/i18n';

const t = UI.no.pages;
const metadata = { title: t.asrUndAso };
---

<PageLayout metadata={metadata}>
  <PageSection title={t.asrUndAso}>
    <h2 class="text-2xl font-semibold mb-4">{t.asrTitle}</h2>
    <p class="text-muted mb-6">{t.asrText}</p>
    <h2 class="text-2xl font-semibold mb-4">{t.asoTitle}</h2>
    <p class="text-muted mb-6">{t.asoText}</p>
    <p class="text-muted">{t.asrMore}</p>
  </PageSection>
</PageLayout>
