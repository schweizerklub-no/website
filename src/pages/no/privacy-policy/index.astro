---
import PageSection from '~/components/PageSection.astro';
import PageLayout from '~/layouts/PageLayout.astro';
import { UI } from '~/i18n';

const t = UI.no.pages;
const m = UI.no.misc;
const metadata = { title: t.privacy };
---

<PageLayout metadata={metadata}>
  <PageSection prose>
    <h1>{t.privacy}</h1>

    <p>{t.privacyIntro}</p>

    <h2>{t.privacyHeading1}</h2>
    <p>{t.privacyData}</p>

    <h2>{t.privacyHeading2}</h2>
    <p>{t.privacyCookies}</p>

    <h2>{t.privacyHeading3}</h2>
    <p>{t.privacyContact}</p>
    <p>
      <a href={`mailto:${m.email}`}>{m.email}</a>
    </p>
  </PageSection>
</PageLayout>
