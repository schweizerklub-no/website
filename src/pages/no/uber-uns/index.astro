---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import BoardMemberCard from '~/components/BoardMemberCard.astro';
import PageSection from '~/components/PageSection.astro';
import CardGrid from '~/components/CardGrid.astro';
import { UI } from '~/i18n';

const t = UI.no.pages;
const boardMembers = await getCollection('board');

const metadata = { title: t.uberUns };
---

<PageLayout metadata={metadata}>
  <PageSection title={t.uberUns}>
    <p class="text-muted mb-6">{t.boardIntro1}</p>
    <p class="text-muted mb-6">{t.boardIntro2}</p>
  </PageSection>

  {boardMembers.length > 0 && (
    <CardGrid title={t.vorstand}>
      {boardMembers.map((member) => (
        <BoardMemberCard member={member} showEmail />
      ))}
    </CardGrid>
  )}
</PageLayout>
