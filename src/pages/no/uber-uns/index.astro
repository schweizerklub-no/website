---
import { getCollection, getEntry, render } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import BoardMemberCard from '~/components/BoardMemberCard.astro';
import PageSection from '~/components/PageSection.astro';
import CardGrid from '~/components/CardGrid.astro';

const t = Astro.locals.t.pages;
const entry = (await getEntry("pages", `${Astro.locals.locale}/uber-uns`))!;
const { Content } = await render(entry);
const boardMembers = await getCollection("board", ({ data }) => data.lang === Astro.locals.locale);

const metadata = { title: entry.data.title };
---

<PageLayout metadata={metadata}>
  <PageSection title={entry.data.title} prose>
    <Content />
  </PageSection>

  {boardMembers.length > 0 && (
    <CardGrid title={t.vorstand}>
      {boardMembers.map((member) => (
        <BoardMemberCard member={member} showEmail />
      ))}
    </CardGrid>
  )}
</PageLayout>
