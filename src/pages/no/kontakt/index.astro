---
import PageLayout from '~/layouts/PageLayout.astro';
import PageSection from '~/components/PageSection.astro';

const { pages: t, misc: m } = Astro.locals.t;
const metadata = { title: t.kontakt };
---

<PageLayout metadata={metadata}>
  <PageSection title={t.kontakt}>
    <p class="text-muted mb-8">{t.contactIntro}</p>

    <div class="border border-default rounded-lg p-6 mb-8">
      <h2 class="text-xl font-semibold mb-4">{t.vorstand}</h2>
      <a href={`mailto:${m.email}`} class="text-primary hover:underline font-medium">
        {m.email}
      </a>
    </div>

    <div class="border border-default rounded-lg p-6 mb-8">
      <h2 class="text-xl font-semibold mb-4">{t.adresse}</h2>
      <p class="text-muted">
        Schweizer Klub Norwegen Oslo<br />
        {m.addressLine1}<br />
        {m.addressLine2}<br />
        {m.addressLine3}
      </p>
    </div>

    <div class="border border-default rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-4">{t.socialMedia}</h2>
      <div class="flex gap-4">
        <a href="https://www.facebook.com/schweizerklubnorwegen/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
          Facebook
        </a>
        <a href="https://www.instagram.com/schweizerklub/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
          Instagram
        </a>
      </div>
    </div>
  </PageSection>
</PageLayout>
