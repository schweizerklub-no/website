---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import EventCard from '~/components/EventCard.astro';
import PageSection from '~/components/PageSection.astro';
import CardGrid from '~/components/CardGrid.astro';
import { getUpcomingEvents, getPastEvents } from '~/utils/events';

const upcomingEvents = await getUpcomingEvents();
const pastEvents = await getPastEvents();

const metadata = { title: 'Anlässe' };
---

<PageLayout metadata={metadata}>
  <PageSection title="Anlässe">
    {upcomingEvents.length > 0 ? (
      <>
        <h2 class="text-2xl font-semibold mb-4">Bevorstehende Anlässe</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          {upcomingEvents.map((event) => (
            <EventCard event={event} showWeekday />
          ))}
        </div>
      </>
    ) : (
      <p class="text-muted mb-16">Derzeit sind keine Anlässe geplant. Schauen Sie bald wieder vorbei!</p>
    )}

    {pastEvents.length > 0 && (
      <>
        <h2 class="text-2xl font-semibold mb-4">Vergangene Anlässe</h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pastEvents.map((event) => (
            <EventCard event={event} past showWeekday />
          ))}
        </div>
      </>
    )}
  </PageSection>
</PageLayout>
