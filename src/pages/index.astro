---
import { getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import EventCard from "~/components/EventCard.astro";
import BoardMemberCard from "~/components/BoardMemberCard.astro";
import CardGrid from "~/components/CardGrid.astro";
import { getUpcomingEvents } from "~/utils/events";
import { UI } from "~/i18n";

const t = UI.de;
const upcomingEvents = await getUpcomingEvents(3);
const boardMembers = await getCollection("board");

const metadata = {
  title: t.home.metaTitle,
};
---

<PageLayout metadata={metadata}>
  <HeroText
    title={t.home.title}
    tagline={t.home.tagline}
    backgroundImage="/images/hero-bg.jpg"
    callToAction={{
      text: t.home.cta1,
      href: "/beitritt/",
    }}
    callToAction2={{
      text: t.home.cta2,
      href: "/uber-uns/",
    }}
  />

  {
    upcomingEvents.length > 0 && (
      <CardGrid title={t.home.events} wide>
        {upcomingEvents.map((event) => (
          <EventCard event={event} />
        ))}
      </CardGrid>
    )
  }

  {
    boardMembers.length > 0 && (
      <CardGrid title={t.home.board} wide bgPage>
        {boardMembers.map((member) => (
          <BoardMemberCard
            member={member}
            imageSize="w-24 h-24"
            avatarTextSize="text-2xl"
          />
        ))}
      </CardGrid>
    )
  }
</PageLayout>
