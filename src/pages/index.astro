---
import { getCollection } from 'astro:content';
import PageLayout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import EventCard from '~/components/EventCard.astro';
import BoardMemberCard from '~/components/BoardMemberCard.astro';

const events = await getCollection('events');
const upcomingEvents = events
  .filter((e) => !e.data.visibilityEnd || e.data.visibilityEnd >= new Date())
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const boardMembers = await getCollection('board');

const metadata = {
  title: 'Schweizer Klub Norwegen Oslo',
};
---

<PageLayout metadata={metadata}>
  <HeroText
    title="Herzlich willkommen"
    subtitle="Der Schweizer Klub Norwegen Oslo verbindet in Norwegen lebende SchweizerInnen und Personen mit einer speziellen Verbindung zur Schweiz."
    tagline="Schweizer Klub Norwegen Oslo"
    callToAction={{
      text: 'Mitglied werden',
      href: '/beitritt/',
    }}
    callToAction2={{
      text: 'Nächste Anlässe',
      href: '/anlasse/',
    }}
  />

  {upcomingEvents.length > 0 && (
    <section class="py-16 px-4">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center">Nächste Anlässe</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {upcomingEvents.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      </div>
    </section>
  )}

  {boardMembers.length > 0 && (
    <section class="py-16 px-4 bg-page">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center">Der Vorstand</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {boardMembers.map((member) => (
            <BoardMemberCard member={member} imageSize="w-24 h-24" avatarTextSize="text-2xl" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Mitglied werden</h2>
      <p class="text-muted mb-6">
        Werden Sie Teil des Schweizer Klub Norwegen Oslo. Wir freuen uns auf Sie!
      </p>
      <a
        href="/beitritt/"
        class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-primary text-white font-medium hover:bg-primary/90 transition-colors"
      >
        Beitritt & Mitgliedschaft
      </a>
    </div>
  </section>
</PageLayout>
