---
import { getCollection } from "astro:content";
import PageLayout from "~/layouts/PageLayout.astro";
import HeroText from "~/components/widgets/HeroText.astro";
import EventCard from "~/components/EventCard.astro";
import BoardMemberCard from "~/components/BoardMemberCard.astro";
import CardGrid from "~/components/CardGrid.astro";
import { getUpcomingEvents } from "~/utils/events";

const upcomingEvents = await getUpcomingEvents(3);
const boardMembers = await getCollection("board");

const metadata = {
  title: "Schweizer Klub Norwegen Oslo",
};
---

<PageLayout metadata={metadata}>
  <HeroText
    title="Herzlich willkommen"
    tagline="Schweizer Klub Norwegen Oslo"
    callToAction={{
      text: "Mitglied werden",
      href: "/beitritt/",
    }}
    callToAction2={{
      text: "Über uns",
      href: "/uber-uns/",
    }}
  />

  {
    upcomingEvents.length > 0 && (
      <CardGrid title="Nächste Anlässe" wide>
        {upcomingEvents.map((event) => (
          <EventCard event={event} />
        ))}
      </CardGrid>
    )
  }

  {
    boardMembers.length > 0 && (
      <CardGrid title="Der Vorstand" wide bgPage>
        {boardMembers.map((member) => (
          <BoardMemberCard
            member={member}
            imageSize="w-24 h-24"
            avatarTextSize="text-2xl"
          />
        ))}
      </CardGrid>
    )
  }

  <section class="py-16 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Mitglied werden</h2>
      <p class="text-muted mb-6">
        Werden Sie Teil des Schweizer Klub Norwegen Oslo. Wir freuen uns auf
        Sie!
      </p>
      <a
        href="/beitritt/"
        class="inline-flex items-center justify-center px-6 py-3 rounded-md bg-primary text-white font-medium hover:bg-primary/90 transition-colors"
      >
        Beitritt & Mitgliedschaft
      </a>
    </div>
  </section>
</PageLayout>
