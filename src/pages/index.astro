---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Schweizer Klub Norwegen Oslo',
};
---

<Layout metadata={metadata}>
  <section class="py-24 flex flex-col items-center justify-center text-center px-4">
    <h1 class="text-4xl font-bold tracking-tight sm:text-6xl mb-4">
      Herzlich willkommen
    </h1>
    <p class="text-xl text-muted max-w-2xl">
      Der Schweizer Klub Norwegen Oslo verbindet in Norwegen lebende SchweizerInnen
      und Personen mit einer speziellen Verbindung zur Schweiz.
    </p>
  </section>
</Layout>
