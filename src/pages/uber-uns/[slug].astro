---
import { render } from 'astro:content';
import BoardDetail from '~/components/pages/BoardDetail.astro';
import { Locale } from '~/config';
import { getDetailPaths } from '~/utils/locale';

export async function getStaticPaths() {
  return getDetailPaths("board", Locale.De);
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BoardDetail {entry} {Content} />
